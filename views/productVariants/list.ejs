<h3>Biến thể sản phẩm: <%= product.name %></h3>

<style>
  .btn {
    display: inline-block;
    padding: 6px 14px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
    margin-right: 4px;
  }
  .btn-edit {
    background-color: #f0ad4e;
    color: #fff;
  }
  .btn-edit:hover {
    background-color: #ec971f;
  }
  .btn-delete {
    background-color: #d9534f;
    color: #fff;
  }
  .btn-delete:hover {
    background-color: #c9302c;
  }
  .btn-save {
    background-color: #5cb85c;
    color: #fff;
  }
  .btn-save:hover {
    background-color: #449d44;
  }
  .btn-cancel {
    background-color: #6c757d;
    color: #fff;
  }
  .btn-cancel:hover {
    background-color: #5a6268;
  }
</style>

<table border="1" cellpadding="6">
  <thead>
    <tr>
      <th>Size</th>
      <th>Màu</th>
      <th>Giá</th>
      <th>Giá giảm</th>
      <th>Tồn kho</th>
      <th>Hình ảnh</th>
      <th>Hành động</th>
    </tr>
  </thead>
  <tbody>
    <% variants.forEach(v => { %>
    <tr>
      <td><%= v.size %></td>
      <td><%= v.color %></td>
      <td><%= v.price %></td>
      <td><%= v.discountPrice %></td>
      <td><%= v.stock %></td>
      <td>
        <% if (v.image) { %>
        <img src="<%= v.image %>" alt="variant" width="60" style="border-radius: 6px" />
        <% } else { %>
        <span>Không có</span>
        <% } %>
      </td>
      <td>
        <button
          type="button"
          class="btn btn-edit"
          data-variant='<%- JSON.stringify({
            _id: v._id,
            size: v.size,
            color: v.color,
            price: v.price,
            discountPrice: v.discountPrice,
            stock: v.stock,
            image: v.image
          }) %>'
          onclick="openEditModal(JSON.parse(this.dataset.variant))"
        >
          Sửa
        </button>

        <form
          method="POST"
          action="/productVariants/<%= v._id %>?_method=DELETE"
          style="display: inline"
        >
          <button type="submit" class="btn btn-delete" onclick="return confirm('Xóa?')">
            Xóa
          </button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<h4>Thêm biến thể mới</h4>
<form method="POST" action="/productVariants" enctype="multipart/form-data">
  <input type="hidden" name="product" value="<%= product._id %>" />
  <input type="text" name="size" placeholder="Size" required />
  <input type="text" name="color" placeholder="Màu" required />
  <input type="number" name="price" placeholder="Giá" required />
  <input type="number" name="discountPrice" placeholder="Giá giảm" />
  <input type="number" name="stock" placeholder="Tồn kho" required />
  <input type="file" name="image" accept="image/*" />
  <button type="submit" class="btn btn-save">Thêm</button>
</form>

<!-- Modal sửa biến thể -->
<div id="editModal" style="
  display:none; position:fixed; top:0; left:0; width:100%; height:100%;
  background:rgba(0,0,0,0.5); align-items:center; justify-content:center;
">
  <div style="background:#fff; padding:20px; border-radius:8px; min-width:320px;">
    <h4>Sửa biến thể</h4>
    <form
      id="editForm"
      method="POST"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="_method" value="PUT" />

      <label>Size</label>
      <input type="text" name="size" id="edit_size" required /><br />

      <label>Màu</label>
      <input type="text" name="color" id="edit_color" required /><br />

      <label>Giá</label>
      <input type="number" name="price" id="edit_price" required /><br />

      <label>Giá giảm</label>
      <input type="number" name="discountPrice" id="edit_discountPrice" /><br />

      <label>Tồn kho</label>
      <input type="number" name="stock" id="edit_stock" required /><br />

      <label>Ảnh hiện tại</label><br />
      <img id="edit_currentImage" width="60" style="border-radius:6px" /><br />

      <label>Đổi ảnh (bỏ trống nếu giữ ảnh cũ)</label>
      <input type="file" name="image" accept="image/*" /><br /><br />

      <button type="submit" class="btn btn-save">Lưu</button>
      <button type="button" class="btn btn-cancel" onclick="closeEditModal()">Hủy</button>
    </form>
  </div>
</div>

<script>
  function openEditModal(variant) {
    const form = document.getElementById("editForm");
    form.action = "/productVariants/" + variant._id;

    document.getElementById("edit_size").value = variant.size || "";
    document.getElementById("edit_color").value = variant.color || "";
    document.getElementById("edit_price").value = variant.price || "";
    document.getElementById("edit_discountPrice").value = variant.discountPrice || "";
    document.getElementById("edit_stock").value = variant.stock || "";

    const img = document.getElementById("edit_currentImage");
    if (variant.image) {
      img.src = variant.image;
      img.style.display = "inline-block";
    } else {
      img.style.display = "none";
    }

    document.getElementById("editModal").style.display = "flex";
  }

  function closeEditModal() {
    document.getElementById("editModal").style.display = "none";
  }
</script>
