<style>
  .detail-wrap { padding: 24px; max-width: 900px; }
  .detail-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .detail-header h1 { font-size: 22px; font-weight: 700; margin: 0; }
  .back-link { font-size: 14px; color: #555; text-decoration: none; }
  .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.08); padding: 20px; margin-bottom: 20px; }
  .card h2 { font-size: 15px; font-weight: 700; margin: 0 0 14px; color: #333; }
  .row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
  .row span:first-child { color: #777; }
  .row span:last-child { font-weight: 600; text-align: right; }
  .badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .badge-pending { background: #fff4e5; color: #b8720b; }
  .badge-paid { background: #e6f0ff; color: #1a56c4; }
  .badge-shipped { background: #eaf0ff; color: #3d4ed8; }
  .badge-completed { background: #e6f8ec; color: #17803d; }
  .badge-cancelled { background: #fdeaea; color: #c62828; }
  .items-table { width: 100%; border-collapse: collapse; }
  .items-table th, .items-table td { text-align: left; padding: 8px 4px; font-size: 14px; border-bottom: 1px solid #f0f0f0; }
  .items-table th { color: #777; font-weight: 600; font-size: 12px; text-transform: uppercase; }
  .total-row td { border-top: 2px solid #eee; font-weight: 700; padding-top: 10px; }
  .actions { display: flex; gap: 10px; margin-top: 4px; }
  .actions form { display: inline; }
  .btn { border: none; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; }
  .btn-approve { background: #16a34a; color: #fff; }
  .btn-approve:hover { background: #128a3e; }
  .btn-cancel { background: #dc2626; color: #fff; }
  .btn-cancel:hover { background: #b91c1c; }
  .btn-complete { background: #2563eb; color: #fff; }
  .btn-complete:hover { background: #1d4ed8; }
  .no-actions { color: #888; font-size: 14px; }
</style>

<div class="detail-wrap">
  <div class="detail-header">
    <div>
      <a class="back-link" href="/orders">&larr; Danh sách đơn hàng</a>
      <h1>Đơn hàng #<%= String(order._id).slice(-8) %></h1>
    </div>
    <%
      const statusLabels = {
        pending: "Chờ xử lý",
        paid: "Đã thanh toán",
        shipped: "Đang giao",
        completed: "Hoàn tất",
        cancelled: "Đã hủy",
      };
    %>
    <span class="badge badge-<%= order.status %>"><%= statusLabels[order.status] || order.status %></span>
  </div>

  <div class="card">
    <h2>Khách hàng</h2>
    <div class="row"><span>Họ tên</span><span><%= order.user?.name || order.user?.fullName || "—" %></span></div>
    <div class="row"><span>Email</span><span><%= order.user?.email || "—" %></span></div>
    <% if (order.shippingAddress) { %>
      <div class="row"><span>Người nhận</span><span><%= order.shippingAddress.fullName %></span></div>
      <div class="row"><span>SĐT</span><span><%= order.shippingAddress.phone %></span></div>
      <div class="row"><span>Địa chỉ</span><span>
        <%= order.shippingAddress.address %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.country %>
      </span></div>
    <% } %>
  </div>

  <div class="card">
    <h2>Sản phẩm</h2>
    <table class="items-table">
      <thead>
        <tr><th>Sản phẩm</th><th>Biến thể</th><th>SL</th></tr>
      </thead>
      <tbody>
        <% order.products.forEach(item => { %>
          <tr>
            <td><%= item.product?.name || "—" %></td>
            <td>
              <% if (item.variant) { %>
                <%= item.variant.size || "" %><%= item.variant.color ? ", " + item.variant.color : "" %>
              <% } else { %>—<% } %>
            </td>
            <td><%= item.quantity %></td>
          </tr>
        <% }) %>
        <tr class="total-row">
          <td colspan="2">Tổng cộng</td>
          <td><%= Number(order.totalPrice || 0).toLocaleString("vi-VN") %>₫</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Thanh toán &amp; Vận chuyển</h2>
    <div class="row"><span>Phương thức</span><span><%= order.paymentMethod === "cash" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản ngân hàng" %></span></div>
    <div class="row"><span>Trạng thái thanh toán</span><span><%= order.payment?.status || "—" %></span></div>
    <div class="row"><span>Đơn vị vận chuyển</span><span><%= order.shipping?.provider || "—" %></span></div>
    <div class="row"><span>Trạng thái vận chuyển</span><span><%= order.shipping?.status || "—" %></span></div>
    <% if (order.voucher) { %>
      <div class="row"><span>Voucher</span><span><%= order.voucher.code || order.voucher.name %></span></div>
    <% } %>
  </div>

  <div class="card">
    <h2>Hành động</h2>
    <% if (order.status === "pending" || order.status === "paid") { %>
      <div class="actions">
        <form method="POST" action="/orders/<%= order._id %>/approve"
              onsubmit="return confirm('Duyệt đơn hàng này để chuyển sang trạng thái đang giao?');">
          <button type="submit" class="btn btn-approve">Duyệt đơn (chuyển sang giao hàng)</button>
        </form>
        <form method="POST" action="/orders/<%= order._id %>/cancel"
              onsubmit="return confirm('Hủy đơn hàng này?');">
          <button type="submit" class="btn btn-cancel">Hủy đơn</button>
        </form>
      </div>
    <% } else if (order.status === "shipped") { %>
      <div class="actions">
        <form method="POST" action="/orders/<%= order._id %>/complete"
              onsubmit="return confirm('Xác nhận đơn hàng đã giao thành công?');">
          <button type="submit" class="btn btn-complete">Hoàn tất đơn hàng</button>
        </form>
        <form method="POST" action="/orders/<%= order._id %>/cancel"
              onsubmit="return confirm('Hủy đơn hàng này?');">
          <button type="submit" class="btn btn-cancel">Hủy đơn</button>
        </form>
      </div>
    <% } else { %>
      <p class="no-actions">Đơn hàng đã <%= order.status === "completed" ? "hoàn tất" : "bị hủy" %>, không còn thao tác nào.</p>
    <% } %>
  </div>
</div>